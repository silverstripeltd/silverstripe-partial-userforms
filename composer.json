{
    "name": "firesphere/partialuserforms",
    "description": "Store partial userform submissions",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "Userforms",
        "editable",
        "form",
        "partial",
        "SilverStripe"
    ],
    "authors": [
        {
            "name": "Simon Erkelens",
            "email": "simonerkelens@silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "silverstripe/recipe-cms": "^6",
        "silverstripe/userforms": "^7",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3.0",
        "scriptfusion/phpunit-immediate-exception-printer": "^3.5"
    },
    "extra": {
        "installer-name": "partialuserforms",
        "branch-alias": {
            "1.x-dev": "5.0.x-dev",
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client/dist"
        ],
        "autoload-dev": {
            "psr-4": {
                "Firesphere\\PartialUserForms\\Controllers": "src/controllers",
                "Firesphere\\PartialUserForms\\Extensions": "src/extensions",
                "Firesphere\\PartialUserForms\\Models": "src/models",
                "Firesphere\\PartialUserForms\\Jobs": "src/jobs"
            }
        },
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
